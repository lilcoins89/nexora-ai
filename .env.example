# Site
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional durable auth + workspace persistence
# DATABASE_URL=postgres://user:password@host:5432/nexora

# AI — Vercel AI Gateway (preferred on Vercel)
