# Site
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional durable auth + workspace persistence
# DATABASE_URL=postgres://user:password@host:5432/nexora

# AI — Vercel AI Gateway (preferred on Vercel)
# AI_GATEWAY_API_KEY=

# Optional external LangChain / LangGraph runtime
# LANGCHAIN_AGENT_URL=https://your-agent-service.example.com/turn
# LANGCHAIN_AGENT_TOKEN=

# GitHub OAuth is handled through Vercel Connect in production.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Netlify — team agricoin8-debug (extensions + deploys)
# Create a PAT: https://app.netlify.com/user/applications#personal-access-tokens
# Team extensions: https://app.netlify.com/teams/agricoin8-debug/extensions
NETLIFY_AUTH_TOKEN=
NETLIFY_TEAM_SLUG=agricoin8-debug
